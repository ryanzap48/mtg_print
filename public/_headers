# Netlify / Cloudflare Pages.
#
# Filenames under assets/ carry a content hash, so a change to a file changes its URL. That is
# what makes an immutable, year-long cache safe: a browser never needs to revalidate, and a
# deploy is picked up because the HTML points at new URLs.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML must not be cached that way, or a deploy would never reach anyone holding an old copy.
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# Regenerated every build and read by crawlers, so a stale copy is worse than a fetch.
/sitemap.xml
  Cache-Control: public, max-age=3600
/robots.txt
  Cache-Control: public, max-age=3600
/llms.txt
  Cache-Control: public, max-age=3600

# Icons and the link-preview image keep their names across deploys, so they are cached for a day
# rather than forever: long enough to be free on repeat visits, short enough that replacing one
# actually shows up.
/*.png
  Cache-Control: public, max-age=86400
/favicon.ico
  Cache-Control: public, max-age=86400
/favicon.svg
  Cache-Control: public, max-age=86400
