# Canonical public URL of the deployed site, no trailing slash.
#
# Drives sitemap.xml, robots.txt and llms.txt, and every absolute URL in the HTML: canonical
# links, og:url, og:image and the @ids in the structured data. vite.config.ts mirrors it into
# VITE_SITE_URL for the app bundle, so this one variable is the only place the domain is set.
# Without it the build writes no SEO files and canonical URLs fall back to the current origin.
SITE_URL=https://your-domain.com

# Google Analytics 4 measurement ID. Leave unset to disable analytics entirely —
# with no ID, no consent banner is shown and no Google script is ever loaded.
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Feedback form. Without an endpoint the form is replaced by a short note, so the site still
# builds and deploys cleanly with this unset.
#
# Formspree  (50 messages/month free, dashboard inbox + email):
#   VITE_FEEDBACK_ENDPOINT=https://formspree.io/f/xxxxxxxx
#
# Web3Forms  (250 messages/month free, emailed straight to you, no dashboard):
#   VITE_FEEDBACK_ENDPOINT=https://api.web3forms.com/submit
#   VITE_FEEDBACK_ACCESS_KEY=your-access-key
#
# Both values are public by design: they name a destination inbox, they do not authorise
# anything, so shipping them in the bundle is expected.
VITE_FEEDBACK_ENDPOINT=
VITE_FEEDBACK_ACCESS_KEY=
